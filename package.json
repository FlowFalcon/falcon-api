{
  "name": "falcon-api",
  "version": "1.0.0",
  "description": "A simple and customizable API documentation interface built with Express.js.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --no-deprecation index.js",
    "build": "npm run minify-css && npm run minify-js",
    "minify-css": "npx uglifycss api-page/styles.css --output api-page/styles.min.css",
    "minify-js": "npx uglify-js api-page/script.js --compress --mangle --output api-page/script.min.js",
    "watch": "npx nodemon --no-deprecation index.js",
    "optimize": "npm run build && npm run optimize-images",
    "optimize-images": "echo 'Image optimization completed'"
  },
  "author": "Skyzopedia",
  "license": "MIT",
  "dependencies": {
    "@fongsidev/scraper": "^1.0.2-4.2",
    "@rynn-k/proxy-agent": "latest",
    "@supabase/supabase-js": "2.49.4",
    "@vercel/analytics": "latest",
    "@vreden/youtube_scraper": "^1.2.5",
    "async-g-i-s": "^1.5.5",
    "axios": "^1.6.8",
    "body-parser": "^1.20.3",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "express": "^4.19.2",
    "file-type": "^16.5.3",
    "form-data": "^4.0.1",
    "fs": "^0.0.1-security",
    "groq-sdk": "^0.9.1",
    "https": "^1.0.0",
    "https-proxy-agent": "latest",
    "image-size": "latest",
    "jimp": "^0.16.1",
    "moment-timezone": "^0.5.34",
    "multer": "latest",
    "node-fetch": "^2.6.1",
    "node-upload-images": "^1.0.1",
    "nodemon": "^3.1.7",
    "ocr-space-api-wrapper": "^2.3.2",
    "path": "^0.12.7",
    "pdfkit": "0.17.1",
    "qrcode": "^1.5.4",
    "qs": "^6.14.0",
    "yt-search": "^2.12.1"
  },
  "devDependencies": {
    "uglify-js": "^3.19.3",
    "uglifycss": "^0.0.29"
  }
}
